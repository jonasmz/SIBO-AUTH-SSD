# Phase 1 external configuration example. Copy to .env (git-ignored) and adjust.
# Never commit real values, private keys, or databases.

AUTH_JWT_ISSUER=https://auth-api.local
AUTH_JWT_AUDIENCE=authentication-clients
AUTH_JWT_LIFETIME_MINUTES=15
AUTH_HTTP_PORT=8080
AUTH_FRONTEND_ORIGIN=https://auth-api.local
# Optional; defaults to seven days. Must be a positive whole number.
AUTH_REFRESH_SESSION_LIFETIME_DAYS=7

# Host directories OUTSIDE Compose-managed volumes.
# SQLite directory: must be writable by the container's non-root user.
AUTH_SQLITE_HOST_PATH=/srv/auth-api/data
# Directory holding jwt-private.pem (mounted read-only). Restrict permissions (0600 file, 0700 dir).
AUTH_RSA_HOST_PATH=/srv/auth-api/keys

# --- Phase 2: reference consumers (api-a, api-b) ---
# Public half of the Phase 1 key pair, mounted read-only as a single file into both consumers.
# Derive it with: openssl pkey -in jwt-private.pem -pubout -out jwt-public.pem
AUTH_JWT_PUBLIC_KEY_HOST_FILE=/srv/auth-api/keys/jwt-public.pem
# Clock tolerance (seconds, 0-60) applied identically by auth-api (administrative endpoints) and
# both consumers when checking token expiry. One shared variable keeps them consistent.
AUTH_JWT_CLOCK_SKEW_SECONDS=30
# Host ports published for development and acceptance only (production routing is Phase 8).
API_A_HTTP_PORT=8081
API_B_HTTP_PORT=8082

# --- Phase 6: password recovery, email and Data Protection keys ---
# Data Protection key ring: a host directory OUTSIDE the Compose lifecycle (bind mount, never a
# Compose-managed volume). Owned by the container user (APP_UID), mode 0700. Losing it invalidates
# outstanding password-reset tokens.
AUTH_DATAPROTECTION_HOST_PATH=/srv/auth-system/dataprotection
# SMTP provider used only to deliver password-recovery messages. Security: None | StartTls | SslOnConnect.
# Username and password are both set or both empty; keep real values out of version control.
AUTH_SMTP_HOST=smtp.example.invalid
AUTH_SMTP_PORT=587
AUTH_SMTP_SECURITY=StartTls
AUTH_SMTP_USERNAME=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_SENDER_ADDRESS=no-reply@example.invalid
AUTH_SMTP_SENDER_NAME=Authentication API
