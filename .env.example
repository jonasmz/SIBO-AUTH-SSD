# Phase 1 external configuration example. Copy to .env (git-ignored) and adjust.
# Never commit real values, private keys, or databases.

AUTH_JWT_ISSUER=https://auth-api.local
AUTH_JWT_AUDIENCE=authentication-clients
AUTH_JWT_LIFETIME_MINUTES=15
AUTH_HTTP_PORT=8080

# Host directories OUTSIDE Compose-managed volumes.
# SQLite directory: must be writable by the container's non-root user.
AUTH_SQLITE_HOST_PATH=/srv/auth-api/data
# Directory holding jwt-private.pem (mounted read-only). Restrict permissions (0600 file, 0700 dir).
AUTH_RSA_HOST_PATH=/srv/auth-api/keys
